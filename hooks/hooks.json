{
  "description": "Guardrails, routing and autopilot for SVN11X/standards: ask before irreversible actions, block commits while the check fails, stop on written secrets, restore rules after compaction, list the executors at startup, tell a work request which repository, recipe and tools it is about, tell a session when another one changed a file it read, name the likely reason of a prompt cache miss, notify the owner, and keep the autopilot going.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.py\"",
            "timeout": 120
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/secret_scan.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/hooks/secret_scan.py\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Read|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/shift_notice.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/hooks/shift_notice.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/session_probe.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/hooks/session_probe.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/reinject.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/hooks/reinject.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/route_prompt.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/hooks/route_prompt.py\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/cache_notice.py\" prompt 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/hooks/cache_notice.py\" prompt",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/notify.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/hooks/notify.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/autopilot.py\" 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/hooks/autopilot.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/cache_notice.py\" stop 2>/dev/null || python \"${CLAUDE_PLUGIN_ROOT}/hooks/cache_notice.py\" stop",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
